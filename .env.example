# SafeMemo AI — self-hosted configuration.
#
# Copy to .env and fill in. Every value below is required unless marked
# optional; the API refuses to start with a missing or malformed secret.
#
# There are no AI provider keys here. Each user supplies their own Anthropic,
# Google, or OpenAI key after signing up, and it is stored encrypted under
# MASTER_ENCRYPTION_KEY. This server never holds a shared model key.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=safememo
POSTGRES_PASSWORD=
POSTGRES_DB=safememo

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------
# Wraps every stored provider API key. Generate with:
#   openssl rand -base64 32
#
# BACK THIS UP SOMEWHERE OTHER THAN THIS SERVER. Losing it makes every stored
# credential permanently unreadable — users would each have to re-enter their
# provider key. Leaking it, together with a database dump, exposes them all.
MASTER_ENCRYPTION_KEY=
# Label for the current key generation. Bump on rotation (k1 -> k2 -> ...).
MASTER_ENCRYPTION_KEY_ID=k1

# Only set during a rotation; remove once `npm run rotate-master-key` reports
# zero rows remaining on the old generation.
# MASTER_ENCRYPTION_KEY_PREVIOUS=
# MASTER_ENCRYPTION_KEY_PREVIOUS_ID=

# ---------------------------------------------------------------------------
# Sessions and signing
# ---------------------------------------------------------------------------
# openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_DAYS=14

# Signs audit-trail share links. Rotating it invalidates every outstanding
# link, which is the intended behaviour after a suspected leak.
# openssl rand -hex 48
AUDIT_SHARE_SECRET=

# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------
# Exact origin of the web app. No wildcards, no trailing slash.
APP_ORIGIN=http://localhost:3000
API_PORT=8080

# open   — anyone can create an account (typical for a personal instance)
# invite — an admin pre-creates the user row; that email can then set a password
# closed — no new accounts
SIGNUP_MODE=open

# Per-user daily request ceiling. Guards this server's resources; it is not a
# spend cap, because under BYOK the user is billed by their provider directly.
DAILY_REQUEST_LIMIT=2000

# ---------------------------------------------------------------------------
# Embeddings (semantic memory search)
# ---------------------------------------------------------------------------
# local  — in-process ONNX (bge-base-en-v1.5). No API key, no per-call cost,
#          and memory content never leaves this machine. Downloads ~110 MB of
#          model weights on first use.
#          Not available on Intel macOS: onnxruntime-node ships no darwin/x64
#          binary. Use Docker, or switch to google, on an Intel Mac.
# google — the user's own Gemini key via BYOK (text-embedding-004). Sends
#          memory content to Google.
# none   — disabled; memory search degrades to substring matching.
EMBEDDING_PROVIDER=local
