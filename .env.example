# Firebase web config (NEXT_PUBLIC_* are exposed to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=noomachy
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloud Functions secrets (mirror these into Firebase Secrets via
# `firebase functions:secrets:set NAME` for production deploys)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1

# HMAC key for signing audit-trail share tokens. Any high-entropy 32+ byte
# string (generate with `openssl rand -hex 48`). Rotating this invalidates
# every outstanding share link, which is the desired behavior on suspected breach.
AUDIT_SHARE_SECRET=

# MCP + tools
MCP_SERVER_SECRET=
SERPER_API_KEY=
OPENWEATHER_API_KEY=
