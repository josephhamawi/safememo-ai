rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User-scoped file storage
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024; // 50MB limit
    }

    // Skill code storage (admin only write)
    match /skills/{skillId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Agent attachments — NOT used in the core flow. The old rule let any
    // authenticated user read/write any agent's files (agentId is not
    // owner-scoped, and Storage rules can't query Firestore to check
    // ownership), which is a cross-tenant leak on a tenant-isolated product.
    // Locked closed until attachments ship with an owner-scoped path
    // (e.g. /users/{userId}/agents/{agentId}/...).
    match /agents/{agentId}/attachments/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
