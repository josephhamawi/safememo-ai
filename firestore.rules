rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if user owns the resource
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    // Helper: check if user is admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Custom MCP servers
      match /customMcps/{mcpId} {
        allow read, write: if isOwner(userId);
      }

      // Custom slash commands
      match /commands/{commandId} {
        allow read, write: if isOwner(userId);
      }

      // Learning / behavior profiles (admin-only writes, user reads)
      match /learning/{docId} {
        allow read: if isOwner(userId);
        allow write: if isAdmin();
      }

      // Gemini usage tracking
      match /usage/{docId} {
        allow read: if isOwner(userId);
        allow write: if isAdmin();
      }
    }

    // Agents collection
    match /agents/{agentId} {
      allow read: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;

      // L1 - Working Memory (user's own sessions)
      match /workingMemory/{sessionId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
      }

      // L2 - Semantic Memory (validation gate enforced)
      match /semanticMemory/{memoryId} {
        allow read: if isAuthenticated()
          && (
            get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid
            || resource.data.accessControl.visibility == 'public'
            || (resource.data.accessControl.visibility == 'shared'
                && request.auth.uid in resource.data.accessControl.allowedUsers)
          );
        // Only allow creating with 'staging' status (must go through validation)
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid
          && request.resource.data.metadata.validationStatus == 'staging';
        // Only admin (Cloud Function service account) can approve/reject
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      // L2 - Staging queue
      match /stagingMemory/{tempId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
      }

      // L2 - Rejected memories
      match /rejectedMemory/{rejectedId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
        allow write: if isAdmin();
      }

      // L3 - Episodic Decision Log
      match /episodicMemory/{episodeId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
        allow update: if isAdmin(); // Only consolidation function can modify
        allow delete: if false; // Episodic logs are append-only
      }

      // Conversations
      match /conversations/{conversationId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;

        match /messages/{messageId} {
          allow read, write: if isAuthenticated()
            && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
        }
      }
    }

    // Skills collection (read-only for users, admin-write)
    match /skills/{skillId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Audit Logs (append-only, admin-read)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Notifications
    match /notifications/{userId}/{notificationId} {
      allow read: if isOwner(userId);
      allow write: if isAdmin() || isOwner(userId);
    }

    // Auto-pilot Goals
    match /goals/{goalId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
      // Users can change schedule/prompt/status, but cannot move ownership
      // or fabricate run history (those are server-side fields).
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;

      // Run history (read by owner, written by Cloud Function only)
      match /runs/{runId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/goals/$(goalId)).data.ownerId == request.auth.uid;
        allow write: if isAdmin();
      }
    }
  }
}
