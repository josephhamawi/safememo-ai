rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if user owns the resource
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    // Helper: check if user is admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Custom MCP servers
      match /customMcps/{mcpId} {
        allow read, write: if isOwner(userId);
      }

      // Custom slash commands
      match /commands/{commandId} {
        allow read, write: if isOwner(userId);
      }

      // Learning / behavior profiles (admin-only writes, user reads)
      match /learning/{docId} {
        allow read: if isOwner(userId);
        allow write: if isAdmin();
      }

      // Per-tenant daily usage docs (cost guardrail). User can read their
      // own to surface "X% of daily cap used" in the dashboard. Only the
      // server can write.
      match /usage/{docId} {
        allow read: if isOwner(userId);
        allow write: if isAdmin();
      }
    }

    // Agents collection
    match /agents/{agentId} {
      allow read: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;

      // L1 - Working Memory (user's own sessions)
      match /workingMemory/{sessionId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
      }

      // L2 - Semantic Memory (validation gate enforced).
      // Strict tenant isolation: no public/shared paths. Compliance-bound
      // tenants must never be able to mark a memory as cross-tenant readable.
      match /semanticMemory/{memoryId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
        // Direct creation is forbidden: every memory must enter via the
        // staging queue. The Cloud Function (admin) writes here on approval.
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      // L2 - Staging queue
      match /stagingMemory/{tempId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
      }

      // L2 - Rejected memories
      match /rejectedMemory/{rejectedId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
        allow write: if isAdmin();
      }

      // L3 - Episodic Decision Log
      match /episodicMemory/{episodeId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
        allow update: if isAdmin(); // Only consolidation function can modify
        allow delete: if false; // Episodic logs are append-only
      }

      // Conversations
      match /conversations/{conversationId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;

        match /messages/{messageId} {
          allow read, write: if isAuthenticated()
            && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerId == request.auth.uid;
        }
      }
    }

    // Skills collection (read-only for users, admin-write)
    match /skills/{skillId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Audit Logs (append-only). Users can read their own entries; only the
    // server (admin) can write. Cross-tenant reads are blocked. Updates and
    // deletes are forbidden — modifying or removing an entry would invalidate
    // every later chain hash.
    match /auditLogs/{logId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Notifications
    match /notifications/{userId}/{notificationId} {
      allow read: if isOwner(userId);
      allow write: if isAdmin() || isOwner(userId);
    }

    // Early-access requests (landing page lead capture). Anyone can submit;
    // only admins read. Limit field length so spammers can't push 1MB blobs.
    match /earlyAccessRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && request.resource.data.get('useCase', '').size() < 2000
        && request.resource.data.get('name', '').size() < 200
        && request.resource.data.get('organization', '').size() < 200;
      allow update, delete: if false;
    }

  }
}
