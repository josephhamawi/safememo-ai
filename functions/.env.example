# Cloud Functions secrets — local dev only.
# In production, set these via `firebase functions:secrets:set NAME`
# rather than committing them here.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Vertex AI (embeddings)
VERTEX_AI_PROJECT_ID=noomachy
VERTEX_AI_LOCATION=us-central1

# HMAC signing key for audit-trail share tokens. REQUIRED — the auditShare
# Cloud Function won't start without it. Generate with `openssl rand -hex 48`.
# Rotating invalidates every outstanding share link.
AUDIT_SHARE_SECRET=

# MCP + tools
MCP_SERVER_SECRET=
SERPER_API_KEY=
OPENWEATHER_API_KEY=

# Invite-only sign-up gate. Comma-separated emails that can ALWAYS create an
# account (checked before any Firestore lookup, so a founder can't be locked
# out). Everyone else must be in the allowlist / allowlistDomains collections.
# REQUIRED before enabling the beforeUserCreated blocking function.
SIGNUP_ALLOWLIST_BOOTSTRAP=
